<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ShadowHeartsItalianPatcher.Desktop.MainWindow"
    Title="Shadow Hearts: Covenant Italian Patcher"
    Width="1040"
    Height="850"
    MinWidth="800"
    MinHeight="700"
    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
    FontFamily="Segoe UI,DejaVu Sans">
    <ScrollViewer>
        <Grid Margin="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="SHADOW HEARTS: COVENANT"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#648CFF"/>
                    <TextBlock Text="Italian Patcher" FontSize="32" FontWeight="Bold"/>
                    <TextBlock
                        Text="Due dischi. Una nuova ISO italiana. Il tuo originale resta intatto."
                        Opacity="0.7"
                        TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.55"/>
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    Content="Tema scuro"
                    IsChecked="{Binding DarkTheme}"
                    VerticalAlignment="Top"/>
            </Grid>
            <Border Grid.Row="1" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#506486AA">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="1  Scegli la tua ISO originale USA" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox
                            Text="{Binding IsoPath}"
                            IsReadOnly="True"
                            PlaceholderText="Seleziona un file .iso"/>
                        <Button Grid.Column="1" Content="Sfoglia…" Command="{Binding SelectIsoCommand}"/>
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <StackPanel>
                            <TextBlock Text="DISCO RILEVATO" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{Binding Disc}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="REGIONE" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{Binding Region}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="VERIFICA" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{Binding Verification}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="VERSIONE TRADUZIONE" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{Binding Translation}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="2" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#506486AA">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <TextBlock
                        Text="2  Scegli dove salvare la nuova ISO"
                        FontSize="18"
                        FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox
                            Text="{Binding Destination}"
                            IsReadOnly="True"
                            PlaceholderText="Cartella di destinazione"/>
                        <Button
                            Grid.Column="1"
                            Content="Scegli cartella…"
                            Command="{Binding SelectDestinationCommand}"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Spazio richiesto:" Opacity="0.6"/>
                        <TextBlock Text="{Binding Required}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Button
                    Content="Genera ISO italiana"
                    Command="{Binding GenerateCommand}"
                    Background="#3D63DD"
                    Foreground="White"
                    Padding="22,12"/>
                <Button Grid.Column="1" Content="Annulla" Command="{Binding CancelCommand}"/>
                <Button Grid.Column="3" Content="Apri cartella" Command="{Binding OpenFolderCommand}"/>
            </Grid>
            <StackPanel Grid.Row="4" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8"/>
            </StackPanel>
            <TextBox
                Grid.Row="5"
                Text="{Binding Log}"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="150"
                FontFamily="DejaVu Sans Mono,Consolas"
                FontSize="12"/>
            <TextBlock
                Grid.Row="6"
                Text="Traduzione italiana beta. Le patch sono offline e aggiornabili separatamente dall’applicazione."
                Opacity="0.6"
                TextWrapping="Wrap"
                FontSize="12"/>
        </Grid>
    </ScrollViewer>
</Window>
